{
  "name": "@mueo/koishi-plugin-cocofaith-adapter-qq",
  "version": "3.0.0-alpha.3",
  "description": "CoCoFaith v3 QQ 官方机器人平台接入",
  "author": "Mueo <mueo@mueoo.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zsyx-wiki/koishi-plugin-cocofaith-adapter-qq.git"
  },
